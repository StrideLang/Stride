use DesktopAudio version 1.0

import Dsp::Generators as Generators

Generators::Impulse(frequency: 1) >> Generators::AD(attack: 0.01 decay: 0.7) >> Envelope;

Generators::Oscillator(frequency: 880 amplitude: Envelope) >> AudioOut[0];

#Generators::Oscillator(frequency: 440) * Envelope >> AudioOut[0];
