use DesktopAudio version 1.0

import Dsp::Units as N
import Dsp::Generators as Generators

signal Frequency {
    domain: AudioDomain
}

switch SeqTrigger { #FIXME breaks if trigger used instead of switch
    domain: AudioDomain
}

constant Values[4] {
    value: [ N::C4, N::E4, N::G4, N::C5 ]
}

[Generators::Impulse( frequency: 0.5 ), 1.0]
>> Equal()
>> SeqTrigger
>> Generators::Sequencer(values: Values)
>> Frequency;

Generators::Oscillator(frequency: Frequency) >> AudioOut[0];
