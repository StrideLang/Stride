
use DesktopAudio version 1.0

import Dsp::Generators as Generators
import Dsp::Routing as Routing

AudioIn[1] >> Signal >> AudioOut[1];


signal Rate1 {
    rate: 22050
}


signal Rate2 {
    rate: 11025
}

signal AudioRateSig {
    rate: AudioRate
}


Rate1 >> Rate2 >> Output1;

Signal1 >> Rate1 >> Signal2 >> Rate2 >> GetAudioRate >> Output2;

TestModule() >> Rate1 >> Routing::Level(gain: 0.5) >> AudioRateSig;

Generators::Oscillator() >> AudioOut;

module TestModule {
    ports: [
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    streams: [
        Test >> Output;
    ]
}

