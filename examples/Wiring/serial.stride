use Wiring version 1.0

import Dsp::Generators as Generators
import IO::Serial as Serial

signal DownSample {
    rate:   5
    domain: PlatformDomain
}

signal Frequency {
    domain: PlatformDomain
}

1 + AnalogIn[1] * (1.0/128.0) >> Frequency;

AnalogIn[2] + AnalogIn[3] >> DownSample >> Serial::Print();

AnalogIn[2] >> SerialOut[1];

[ Generators::Oscillator ( frequency: Frequency ) , 0 ] >> Greater() >> DigitalOut[14];
