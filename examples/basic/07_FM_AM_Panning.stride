# Frequency and Amplitude Modulation with Panning

use DesktopAudio version 1.0

import Dsp::Generators as Generators
import Dsp::Routing as Routing

signal Modulator[3] { rate: AudioRate }

Generators::Oscillator ( frequency: [ 3.0, 1.0, 1.0 ] amplitude: [ 40.0, 0.1, 1.0 ] ) >> Modulator;

Generators::Oscillator ( frequency: 440.0 + Modulator[0] amplitude: Modulator[1] )
>> Routing::Pan ( position: Modulator[2] )
>> AudioOut;
