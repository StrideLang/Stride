# Frequency and Amplitude Modulation

use DesktopAudio version 1.0

import Dsp::Generators as Generators

signal Modulator[2] { rate: AudioRate }

Generators::Oscillator ( frequency: [ 3.0, 1.0 ] amplitude: [ 40.0, 0.1 ] ) >> Modulator;

Generators::Oscillator ( frequency: 440.0 + Modulator[0] amplitude: Modulator[1] ) >> AudioOut;
