# Beating

use DesktopAudio version 1.0

import Dsp::Generators as Generators
import Dsp::Routing as Routing

Generators::Oscillator (frequency: [440, 443, 437, 880, 885, 887] amplitude: 0.1) >> Oscillators;

Oscillators[0]
+ Oscillators[1]
+ Oscillators[2]
+ Oscillators[3]
+ Oscillators[4]
+ Oscillators[5]
>> Routing::Level ( gain: 0.5 )
>> AudioOut;
