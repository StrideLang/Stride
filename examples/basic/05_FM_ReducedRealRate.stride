# Frequency Modulation with Signal Declaration and Real Rate

use DesktopAudio version 1.0

import Dsp::Generators as Generators

signal Modulator {
    rate: 8.90
}

Generators::Oscillator ( frequency: 3.0 amplitude: 40.0 ) >> Modulator;

Generators::Oscillator ( frequency: 440.0 + Modulator amplitude: 0.1 ) >> AudioOut;
